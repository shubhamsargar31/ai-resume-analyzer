# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment
.venv/
env/
venv/
ENV/

# Environment variables, credentials & secrets
.env
.env.*
*.env
secrets.toml
.streamlit/secrets.toml
*.pem
*.key

# Databases & local state
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3

# Personal resumes, private user files & upload caches
