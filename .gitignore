private/
uploads/
temp/
temp_*
user_data/
*.log
*.tmp

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/
